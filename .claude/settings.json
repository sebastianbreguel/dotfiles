{
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(homedir-marker *)"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/sebabreguel/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/claude-hud-context-threshold.sh\""
  },
  "enabledPlugins": {
    "context-mode@context-mode": true,
    "claude-hud@claude-hud": true,
    "compound-engineering@compound-engineering-plugin": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "complexity-optimizer@complexity-optimizer": true,
    "engram@engram": true,
    "code-simplifier@claude-plugins-official": true,
    "coding-tutor@compound-engineering-plugin": true,
    "figma@claude-plugins-official": false,
    "posthog@claude-plugins-official": true,
    "datadog@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    },
    "complexity-optimizer": {
      "source": {
        "source": "github",
        "repo": "sebastianbreguel/agent-complexity-optimizer"
      }
    },
    "compound-engineering-plugin": {
      "source": {
        "source": "github",
        "repo": "EveryInc/compound-engineering-plugin"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "low",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true
}
